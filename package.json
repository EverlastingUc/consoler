{
  "name": "consoler",
  "version": "0.1.0",
  "private": true,
  "description": "Defensive application-security toolkit and explicit source-to-source translator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "import": "./src/server/index.js"
    },
    "./server/rate-limit": {
      "types": "./src/server/rate-limit.d.ts",
      "import": "./src/server/rate-limit.js"
    },
    "./translator/parser": {
      "types": "./src/translator/parser.d.ts",
      "import": "./src/translator/parser.js"
    },
    "./translator/electa": {
      "types": "./src/translator/electa.d.ts",
      "import": "./src/translator/electa.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "import": "./src/config.js"
    },
    "./server/receiver": {
      "types": "./src/server/receiver.d.ts",
      "import": "./src/server/receiver.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "bin": {
    "consoler": "./bin/consoler.js"
  }
}
